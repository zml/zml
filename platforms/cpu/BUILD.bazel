load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library")

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "darwin_amd64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

copy_to_directory(
    name = "sandbox",
    srcs = select({
        ":darwin_arm64": ["@libzml_cpu_darwin_arm64//:libzml_cpu"],
        ":darwin_amd64": ["@libzml_cpu_darwin_amd64//:libzml_cpu"],
        "@platforms//os:linux": ["@libzml_cpu_linux_amd64//:libzml_cpu"],
    }),
    out = "sandbox",
    include_external_repositories = ["**"],
)

cc_library(
    name = "libzml_cpu",
    data = [":sandbox"],
    tags = ["manual"],
)

zig_library(
    name = "cpu",
    import_name = "platforms/cpu",
    main = "cpu.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//pjrt",
        "//platforms:options",
    ] + select({
        "//platforms:cpu.enabled": [
            ":libzml_cpu",
            "//bazel",
            "//stdx",
            "@rules_zig//zig/runfiles",
        ],
        "//conditions:default": [],
    }),
)
