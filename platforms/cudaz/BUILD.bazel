load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_shared_library", "zig_test")
load(":compiler.bzl", "zig_runtime")

zig_runtime(
    name = "zig_runtime",
    kernel = "kernel.zig",
)

zig_shared_library(
    name = "pjrt_plugin",
    srcs = [
        "compiler.zig",
        "cuda.zig",
    ],
    main = "libpjrt_cudaz.zig",
    shared_lib_name = "libpjrt_cudaz.so",
    target_compatible_with = ["@platforms//os:linux"],
    zigopts = ["-fno-stack-check"],
    deps = [
        "//mlir",
        "//mlir/dialects",
        "@rules_zig//zig/runfiles",
        "@xla//xla/pjrt/c:pjrt_c_api_hdrs",
    ],
)

zig_test(
    name = "test",
    srcs = [
        "compiler.zig",
        "cuda.zig",
    ],
    data = [":zig_runtime"],
    main = "libpjrt_cudaz.zig",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//mlir",
        "//mlir/dialects",
        "@rules_zig//zig/runfiles",
        "@xla//xla/pjrt/c:pjrt_c_api_hdrs",
    ],
)

cc_library(
    name = "empty",
    defines = ["ZML_RUNTIME_CUDAZ_DISABLED"],
    tags = ["manual"],
)

cc_library(
    name = "libpjrt_cudaz",
    data = [
        ":pjrt_plugin",
        ":zig_runtime",
    ],
    defines = ["ZML_RUNTIME_CUDAZ"],
    tags = ["manual"],
)

zig_library(
    name = "cudaz",
    import_name = "platforms/cudaz",
    main = "cudaz.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//pjrt",
    ] + select({
        "//platforms:cudaz.enabled": [
            ":libpjrt_cudaz",
            "//bazel",
            "//stdx",
            "@rules_zig//zig/runfiles",
        ],
        "//conditions:default": [":empty"],
    }),
)
