load("@rules_zig//zig:defs.bzl", "zig_library")

exports_files(["libzml_musa.BUILD.bazel"])

zig_library(
    name = "musa",
    import_name = "platforms/musa",
    main = "musa.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//bazel",
        "//pjrt",
        "//platforms:options",
        "//stdx",
    ] + select({
        "//platforms:musa.enabled": ["@libzml_musa"],
        "//conditions:default": [],
    }),
)
