load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library")

copy_file(
    name = "gcc",
    src = "@furiosa_toolchain//:gcc",
    out = "aarch64-linux-gnu-gcc",
    is_executable = True,
    tags = ["manual"],
)

copy_to_directory(
    name = "sandbox",
    srcs = [
        ":gcc",
        "@furiosa_runtime//:files",
        "@furiosa_tcc//:compiler",
        "@furiosa_toolchain//:files",
        "@libzml_furiosa//:lib/libpjrt_c_api_furiosa_plugin.so",
    ],
    out = "sandbox",
    add_directory_to_runfiles = True,
    include_external_repositories = ["**"],
    replace_prefixes = {
        "libstdc++.so.6": "lib",
        "libgcc_s.so.1": "lib",
        "libunwind.so.1": "lib",
        "aarch64-linux-gnu-gcc": "toolchain/usr/bin/aarch64-linux-gnu-gcc",
        "furiosa_tcc-2026.3.0.data/scripts": "libexec",
        "usr": "toolchain/usr",
        "lib/x86_64-linux-gnu": "toolchain/lib/x86_64-linux-gnu",
    },
    tags = ["manual"],
)

cc_library(
    name = "libzml_furiosa",
    data = [":sandbox"],
    tags = ["manual"],
)

zig_library(
    name = "furiosa",
    import_name = "platforms/furiosa",
    main = "furiosa.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//bazel",
        "//pjrt",
        "//platforms:options",
        "//stdx",
    ] + select({
        "//platforms:furiosa.enabled": [":libzml_furiosa"],
        "//conditions:default": [],
    }),
)
