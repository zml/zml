load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library")

cc_library(
    name = "libzml_furiosa",
    data = ["@libzml_furiosa"],
    tags = ["manual"],
)

zig_library(
    name = "furiosa",
    import_name = "platforms/furiosa",
    main = "furiosa.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//bazel",
        "//pjrt",
        "//platforms:options",
        "//stdx",
    ] + select({
        "//platforms:furiosa.enabled": [":libzml_furiosa"],
        "//conditions:default": [],
    }),
)
