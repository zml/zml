load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@tar.bzl//tar:tar.bzl", "tar")
load("@zml//bazel:patchelf.bzl", "patchelf")

patchelf(
    name = "plugin",
    src = "lib/libpjrt_c_api_furiosa_plugin.so",
    set_rpath = "$ORIGIN",
)

patchelf(
    name = "intercept",
    src = "lib/libfuriosa_tcc_intercept.so",
    set_rpath = "$ORIGIN",
)

patchelf(
    name = "tcc",
    src = "libexec/furiosa-tcc",
    set_rpath = "$ORIGIN/../lib",
)

patchelf(
    name = "libstdc++.so.6",
    src = "@libstdcpp6//:files",
    set_rpath = "$ORIGIN",
)

patchelf(
    name = "libgcc_s.so.1",
    src = "@libgcc-s1//:files",
    set_rpath = "$ORIGIN",
)

patchelf(
    name = "libunwind.so.1",
    src = "@llvm-libunwind1//:runtime",
    set_rpath = "$ORIGIN",
)

copy_to_directory(
    name = "sandbox",
    srcs = [
        ":intercept",
        ":libgcc_s.so.1",
        ":libstdc++.so.6",
        ":libunwind.so.1",
        ":plugin",
        ":tcc",
        "@libc6-dev-arm64-cross//:headers",
        "@libc6//:files",
        "@llvm//:builtin_resource_dir",
        "@llvm//tools:clang",
        "@llvm//tools:ld.lld",
    ],
    out = "sandbox",
    add_directory_to_runfiles = True,
    include_external_repositories = ["**"],
    replace_prefixes = {
        "plugin": "lib",
        "intercept": "lib",
        "tcc": "libexec",
        "libstdc++.so.6": "lib",
        "libgcc_s.so.1": "lib",
        "libunwind.so.1": "lib",
        "usr/lib/x86_64-linux-gnu": "lib",
        "usr/aarch64-linux-gnu/include": "toolchain/usr/aarch64-linux-gnu/include",
        "bin": "toolchain/usr/bin",
        "lib/clang/*": "toolchain/lib/clang",
    },
    visibility = ["//visibility:public"],
)

cc_library(
    name = "libzml_furiosa",
    data = [":sandbox"],
    visibility = ["//visibility:public"],
)

# Native executables request an absolute ELF interpreter. This layer supplies
# it and the same pinned runtime used by the sandbox, without a host bind mount.
_RUNTIME = {
    "ld-linux-x86-64.so.2": "@libc6//:usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2",
    "libc.so.6": "@libc6//:usr/lib/x86_64-linux-gnu/libc.so.6",
    "libdl.so.2": "@libc6//:usr/lib/x86_64-linux-gnu/libdl.so.2",
    "libm.so.6": "@libc6//:usr/lib/x86_64-linux-gnu/libm.so.6",
    "libpthread.so.0": "@libc6//:usr/lib/x86_64-linux-gnu/libpthread.so.0",
    "libgcc_s.so.1": ":libgcc_s.so.1",
    "libstdc++.so.6": ":libstdc++.so.6",
    "libunwind.so.1": ":libunwind.so.1",
}

tar(
    name = "runtime_rootfs",
    srcs = _RUNTIME.values(),
    mtree = [
        "lib type=dir uid=0 gid=0 mode=0755 time=0",
        "lib/x86_64-linux-gnu type=dir uid=0 gid=0 mode=0755 time=0",
        "lib64 type=dir uid=0 gid=0 mode=0755 time=0",
        "lib64/ld-linux-x86-64.so.2 type=link link=../lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 uid=0 gid=0 time=0",
    ] + [
        "lib/x86_64-linux-gnu/{} type=file uid=0 gid=0 mode=0755 time=0 content=$(location {})".format(name, label)
        for name, label in _RUNTIME.items()
    ],
    visibility = ["//visibility:public"],
)
