load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@zml//bazel:runtime_groups.bzl", "runtime_group")

# XLA owns the full payload. ZML only places it in the platform's runfiles.
copy_to_directory(
    name = "sandbox",
    srcs = glob(
        [
            "bin/**",
            "include/**",
            "lib/**",
        ],
        allow_empty = False,
    ),
    add_directory_to_runfiles = True,
    visibility = ["//visibility:public"],
)

runtime_group(
    name = "runtime_group",
    group = "furiosa",
)

cc_library(
    name = "libzml_furiosa",
    aspect_hints = [":runtime_group"],
    data = [":sandbox"],
    visibility = ["//visibility:public"],
)
