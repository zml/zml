load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library")

cc_library(
    name = "libzml_tpu",
    tags = ["manual"],
    deps = ["@libzml_tpu"],
)

zig_library(
    name = "tpu",
    import_name = "platforms/tpu",
    main = "tpu.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//bazel",
        "//pjrt",
        "//platforms:options",
        "//stdx",
    ] + select({
        "//platforms:tpu.enabled": [
            ":libzml_tpu",
        ],
        "//conditions:default": [],
    }),
)

zig_library(
    name = "ragged_paged",
    import_name = "platforms/tpu/ragged_paged",
    main = "ragged_paged.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//kernels/mosaic_tpu:mosaic_tpu_builder",
        "//mlir",
    ],
)
