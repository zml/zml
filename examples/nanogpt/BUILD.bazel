load("@rules_zig//zig:defs.bzl", "zig_binary")

zig_binary(
    name = "nanogpt",
    main = "nanogpt.zig",
    args = [
        "$(location weights/nanogpt.safetensors)",
        "$(location weights/nanogpt.backward.safetensors)",
    ],
    data = [
        "weights/nanogpt.safetensors",
        "weights/nanogpt.backward.safetensors",
        "weights/config.json"
    ],
    deps = ["@zml//zml"],
    visibility = ["//visibility:public"],
)

zig_binary(
    name = "torch2zml",
    main = "torch2zml.zig",
    args = [
        "$(location weights/nanogpt.safetensors)",
        "$(location weights/nanogpt.backward.safetensors)",
    ],
    data = [
        "weights/nanogpt.safetensors",
        "weights/nanogpt.backward.safetensors",
    ],
    deps = [
        "@zml//zml",
    ],
)
