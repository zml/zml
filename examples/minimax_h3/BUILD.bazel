load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_zig//zig:defs.bzl", "zig_binary")

H3_SRCS = [
    "audio_vae.zig",
    "conditions.zig",
    "config.zig",
    "decode.zig",
    "dit.zig",
    "encode.zig",
    "encoder.zig",
    "ir.zig",
    "main.zig",
    "media.zig",
    "packing.zig",
    "pipeline.zig",
    "scheduler.zig",
    "session.zig",
    "sharding.zig",
    "vae.zig",
    "vision.zig",
    "visual_enc.zig",
    "visual_vae.zig",
    "weights.zig",
]

zig_binary(
    name = "minimax_h3",
    srcs = H3_SRCS,
    main = "main.zig",
    visibility = ["//visibility:public"],
    deps = ["//zml"],
)

zig_binary(
    name = "h3_tests",
    srcs = H3_SRCS + ["tests.zig"],
    main = "tests.zig",
    visibility = ["//visibility:public"],
    deps = ["//zml"],
)

build_test(
    name = "test",
    targets = [
        ":minimax_h3",
        ":h3_tests",
    ],
)
