load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

cc_library(
    name = "capi",
    srcs = ["capi.cc"],
    hdrs = ["capi.h"],
    tags = ["manual"],
    deps = [
        "@llvm-project//mlir:CAPIIR",
        "@llvm-project//mlir:CAPIROCDL",
        "@llvm-project//mlir:ROCDLDialect",
    ],
)

zig_library(
    name = "rocdl",
    srcs = [
        "annotations.zig",
        "attributes.zig",
        "enums.zig",
        "ops.zig",
        "target.zig",
        "types.zig",
    ],
    import_name = "mlir/dialects/rocdl",
    main = "rocdl.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":capi",
        "//mlir",
        "//mlir/dialects/llvm",
        "//stdx",
    ],
)

zig_test(
    name = "test",
    main = "test.zig",
    deps = [
        ":capi",
        ":rocdl",
        "//mlir",
    ],
)
