load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# The TileView type interface, which NVIDIA's C API does not expose.
cc_library(
    name = "capi",
    srcs = ["capi.cc"],
    hdrs = ["capi.h"],
    visibility = ["//visibility:private"],
    deps = [
        "@cuda_tile//:CudaTileDialect",
        "@llvm-project//mlir:CAPIIR",
    ],
)

zig_library(
    name = "cuda_tile",
    import_name = "mlir/dialects/cuda_tile",
    main = "cuda_tile.zig",
    visibility = ["//visibility:public"],
    deps = [
        ":capi",
        "//mlir",
        "//stdx",
        "@cuda_tile//:cuda_tile_capi",
    ],
)

zig_test(
    name = "test",
    deps = [":cuda_tile"],
)
