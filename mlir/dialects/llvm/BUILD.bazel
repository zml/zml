load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

cc_library(
    name = "capi",
    srcs = ["capi.cc"],
    hdrs = ["capi.h"],
    tags = ["manual"],
    deps = [
        "@llvm-project//mlir:CAPIIR",
        "@llvm-project//mlir:CAPILLVM",
        "@llvm-project//mlir:LLVMDialect",
    ],
)

zig_library(
    name = "llvm",
    srcs = ["ops.zig"],
    import_name = "mlir/dialects/llvm",
    main = "llvm.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":capi",
        "//mlir",
        "//stdx",
        "@llvm-project//mlir:CAPILLVM",
    ],
)

zig_test(
    name = "test",
    main = "test.zig",
    deps = [
        ":llvm",
        "//mlir",
    ],
)
