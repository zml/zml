load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

cc_library(
    name = "capi",
    srcs = [
        "capi.cc",
    ],
    hdrs = [
        "capi.h",
    ],
    tags = ["manual"],
    deps = [
        "@flydsl//:FlyDialect",
        "@flydsl//:TiledOpTraits",
        "@llvm-project//mlir:CAPIIR",
    ],
    alwayslink = True,
)

zig_library(
    name = "fly",
    srcs = [
        "attributes.zig",
        "ops.zig",
        "types.zig",
    ],
    import_name = "mlir/dialects/fly",
    main = "fly.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":capi",
        "//mlir",
        "//stdx",
    ],
)

zig_test(
    name = "test",
    main = "test.zig",
    deps = [
        ":fly",
        "//mlir",
        "//mlir/dialects/arith",
        "//mlir/dialects/fly_rocdl",
        "//mlir/dialects/func",
        "//mlir/dialects/gpu",
        "//mlir/dialects/llvm",
        "//mlir/dialects/math",
        "//mlir/dialects/memref",
        "//mlir/dialects/rocdl",
        "//mlir/dialects/scf",
        "//mlir/dialects/ub",
        "//mlir/dialects/vector",
    ],
)
