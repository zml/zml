load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

cc_library(
    name = "capi",
    srcs = ["capi.cc"],
    hdrs = ["capi.h"],
    tags = ["manual"],
    deps = [
        "@llvm-project//mlir:CAPIIR",
        "@llvm-project//mlir:FuncExtensions",
    ],
)

zig_library(
    name = "func",
    import_name = "mlir/dialects/func",
    main = "func.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":capi",
        "//mlir",
        "//stdx",
    ],
)

zig_test(
    name = "test",
    main = "test.zig",
    deps = [
        ":func",
        "//mlir",
    ],
)
