load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The release's dialect, attributes and types come from the archive; the DSL
# compiler's remaining attributes, types and enums are CuteAttrsCompiler.td,
# CuteTypesCompiler.td and CuteEnums.td, and every one of its operations is
# CuteOps.td, generated from the DSL's Python bindings and compiler.
td_library(
    name = "tabledefs",
    srcs = [
        "CuteAttrsAll.td",
        "CuteAttrsCompiler.td",
        "CuteEnums.td",
        "CuteOps.td",
        "CuteTypesAll.td",
        "CuteTypesCompiler.td",
    ],
    includes = ["/mlir/dialects/cute_ir/include"],
    deps = ["@cute_ir//:cute_ir_dialect_td"],
)

gentbl_cc_library(
    name = "enums_inc_gen",
    includes = ["../../../.."],
    tbl_outs = [
        (
            ["-gen-enum-decls"],
            "CuteEnums.h.inc",
        ),
        (
            ["-gen-enum-defs"],
            "CuteEnums.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "CuteEnums.td",
    deps = [":tabledefs"],
)

gentbl_cc_library(
    name = "attrs_inc_gen",
    includes = ["../../../.."],
    tbl_outs = [
        (
            [
                "-gen-attrdef-decls",
                "-attrdefs-dialect=cute",
            ],
            "CuteAttrDecls.h.inc",
        ),
        (
            [
                "-gen-attrdef-defs",
                "-attrdefs-dialect=cute",
            ],
            "CuteAttrs.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "CuteAttrsAll.td",
    deps = [":tabledefs"],
)

# CuteDialect.h includes the attribute declarations first: they bring the
# enums the attributes and types use.
genrule(
    name = "attrs_h_inc",
    srcs = ["CuteAttrDecls.h.inc"],
    outs = ["CuteAttrs.h.inc"],
    cmd = "(echo '#ifdef GET_ATTRDEF_CLASSES'; " +
          "echo '#include \"cute_ir/Dialect/Cute/IR/CuteEnums.h.inc\"'; " +
          "echo '#endif'; cat $<) > $@",
)

gentbl_cc_library(
    name = "types_inc_gen",
    includes = ["../../../.."],
    tbl_outs = [
        (
            [
                "-gen-typedef-decls",
                "-typedefs-dialect=cute",
            ],
            "CuteTypes.h.inc",
        ),
        (
            [
                "-gen-typedef-defs",
                "-typedefs-dialect=cute",
            ],
            "CuteTypes.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "CuteTypesAll.td",
    deps = [":tabledefs"],
)

gentbl_cc_library(
    name = "ops_inc_gen",
    includes = ["../../../.."],
    tbl_outs = [
        (
            ["-gen-op-decls"],
            "CuteOps.h.inc",
        ),
        (
            ["-gen-op-defs"],
            "CuteOps.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "CuteOps.td",
    deps = [":tabledefs"],
)

cc_library(
    name = "headers",
    hdrs = [
        "CuteAttrs.h.inc",
        "CuteInference.h",
    ],
    includes = ["../../../.."],
    deps = [
        ":attrs_inc_gen",
        ":enums_inc_gen",
        ":ops_inc_gen",
        ":types_inc_gen",
        "@cute_ir//:cute_ir_dialect_header",
        "@cute_ir//:cutegen",
        "@llvm-project//mlir:DataLayoutInterfaces",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:InferTypeOpInterface",
        "@llvm-project//mlir:SideEffectInterfaces",
    ],
)
