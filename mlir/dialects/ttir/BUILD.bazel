load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

cc_library(
    name = "capi",
    srcs = ["capi.cc"],
    hdrs = ["capi.h"],
    tags = ["manual"],
    deps = [
        "@llvm-project//mlir:CAPIIR",
        "@triton//:TritonDialects",
    ],
)

zig_library(
    name = "ttir",
    import_name = "mlir/dialects/ttir",
    main = "ttir.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":capi",
        "//mlir",
        "//stdx",
    ],
)

zig_test(
    name = "test",
    main = "test.zig",
    deps = [
        ":ttir",
        "//mlir",
        "//mlir/dialects/arith",
        "//mlir/dialects/func",
        "//mlir/dialects/math",
        "//mlir/dialects/scf",
    ],
)
