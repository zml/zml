load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# The native subset of the Furiosa XLA plugin's `tcl` dialect
# (xla/backends/furiosa/codegen/tcl/ir): what ZML emits and the plugin's custom
# call parses. Files mirror the plugin's one for one.
td_library(
    name = "tcl_td_files",
    srcs = glob(["*.td"]),
    deps = [
        "@llvm-project//mlir:OpBaseTdFiles",
        "@llvm-project//mlir:SideEffectInterfacesTdFiles",
    ],
)

gentbl_cc_library(
    name = "tcl_dialect_inc_gen",
    tbl_outs = {
        "tcl_dialect.h.inc": ["-gen-dialect-decls"],
        "tcl_dialect.cc.inc": ["-gen-dialect-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "tcl_dialect.td",
    deps = [":tcl_td_files"],
)

gentbl_cc_library(
    name = "tcl_attrs_inc_gen",
    tbl_outs = {
        "tcl_attrs.h.inc": [
            "-gen-attrdef-decls",
            "-attrdefs-dialect=tcl",
        ],
        "tcl_attrs.cc.inc": [
            "-gen-attrdef-defs",
            "-attrdefs-dialect=tcl",
        ],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "tcl_attrs.td",
    deps = [":tcl_td_files"],
)

gentbl_cc_library(
    name = "tcl_types_inc_gen",
    tbl_outs = {
        "tcl_types.h.inc": [
            "-gen-typedef-decls",
            "-typedefs-dialect=tcl",
        ],
        "tcl_types.cc.inc": [
            "-gen-typedef-defs",
            "-typedefs-dialect=tcl",
        ],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "tcl_types.td",
    deps = [":tcl_td_files"],
)

gentbl_cc_library(
    name = "tcl_ops_inc_gen",
    tbl_outs = {
        "tcl_ops.h.inc": ["-gen-op-decls"],
        "tcl_ops.cc.inc": ["-gen-op-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "tcl_ops.td",
    deps = [":tcl_td_files"],
)

cc_library(
    name = "dialect",
    srcs = [
        "tcl_attrs.cc",
        "tcl_dialect.cc",
        "tcl_ops.cc",
        "tcl_types.cc",
    ],
    hdrs = [
        "tcl_attrs.h",
        "tcl_dialect.h",
        "tcl_ops.h",
        "tcl_types.h",
    ],
    tags = ["manual"],
    textual_hdrs = ["ve_instructions.inc"],
    deps = [
        ":tcl_attrs_inc_gen",
        ":tcl_dialect_inc_gen",
        ":tcl_ops_inc_gen",
        ":tcl_types_inc_gen",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:BytecodeOpInterface",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:SideEffectInterfaces",
    ],
)

cc_library(
    name = "tcl_capi",
    srcs = ["tcl_capi.cc"],
    hdrs = ["tcl_capi.h"],
    strip_include_prefix = ".",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [
        ":dialect",
        "@llvm-project//mlir:CAPIIR",
    ],
    alwayslink = True,
)

zig_library(
    name = "tcl",
    import_name = "mlir/dialects/tcl",
    main = "tcl.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":tcl_capi",
        "//mlir",
        "//mlir:c",
        "//stdx",
    ],
)

zig_test(
    name = "test",
    deps = [":tcl"],
)
