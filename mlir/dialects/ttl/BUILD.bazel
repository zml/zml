load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

cc_library(
    name = "ttl_capi",
    srcs = ["ttl_capi.cc"],
    hdrs = ["ttl_capi.h"],
    strip_include_prefix = ".",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [
        "@llvm-project//mlir:CAPIIR",
        "@tt_lang//:TTLangCAPI",
    ],
    alwayslink = True,
)

zig_library(
    name = "ttl",
    srcs = ["ops.zig"],
    import_name = "mlir/dialects/ttl",
    main = "ttl.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":ttl_capi",
        "//mlir",
        "//mlir:c",
        "//mlir/dialects/ttkernel",
        "//stdx",
    ],
)

zig_test(
    name = "test",
    deps = [":ttl"],
)
