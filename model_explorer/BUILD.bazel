load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_test")
load(":zig_proto_library.bzl", "zig_proto_library")

load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")

# bazel run //pretty_xla:requirements.update
# Note this is overkill, it pulls module like IPython or numpy we don't use,
# but are mentionned by model-explorer requirements.
# To workaround this we could only depend on "@pypi_pretty_xla//ai_edge_model_explorer:data"
# which is the html/js used by the UI and ai-edge-model-explorer-adapter which is bare bone
# then re-implement the rest.
# Which could be a plus considering how messing the python code of model-explorer is.
compile_pip_requirements(
    name = "requirements",
    timeout = "long",
    requirements_in = "requirements.in",
    requirements_txt = "requirements.lock.txt",
)

py_binary(
    name = "server",
    srcs = ["server.py", "hlo2json.py"],
    imports = ["."],
    data = [":pretty_xla_lib"],
    deps = [
        "@pypi_pretty_xla//flask:pkg",
        "@pypi_pretty_xla//requests:pkg",
        "@pypi_pretty_xla//ai_edge_model_explorer:pkg",
    ],
)

zig_binary(
    name = "hlo2json",
    srcs = ["json_writer.zig"],
    main = "hlo2json.zig",
    deps = [":hlo_proto"],
)

zig_proto_library(
    name = "hlo_proto",
    import_name = "@xla//xla/service:hlo_proto",
    proto_package = "xla",
    deps = ["@xla//xla/service:hlo_proto"],
)

zig_test(
    name = "test",
    srcs = ["json_writer.zig"],
    main = "hlo2json.zig",
    deps = [":hlo_proto"],
)
