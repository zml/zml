load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_test")
load(":zig_proto_library.bzl", "zig_proto_library")

zig_binary(
    name = "hlo2json",
    srcs = ["json_writer.zig"],
    main = "hlo2json.zig",
    deps = [":hlo_proto"],
)

zig_proto_library(
    name = "hlo_proto",
    import_name = "@xla//xla/service:hlo_proto",
    proto_package = "xla",
    deps = ["@xla//xla/service:hlo_proto"],
)

zig_test(
    name = "test",
    srcs = ["json_writer.zig"],
    main = "hlo2json.zig",
    deps = [":hlo_proto"],
)
