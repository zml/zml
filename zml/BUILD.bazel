load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

zig_library(
    name = "zml",
    srcs = [
        "attention/Options.zig",
        "attention/attention.zig",
        "kernels/flash_attention/flash_attention.zig",
        "kernels/flash_attention/tests.zig",
        "kernels/moe/api.zig",
        "kernels/moe/moe.zig",
        "kernels/moe/tests.zig",
        "kernels/moe/weights.zig",
        "kernels/paged_attention/options.zig",
        "kernels/paged_attention/paged_attention.zig",
        "zml.zig",
        "//zml/kernels/flash_attention/cute",
        "//zml/kernels/flash_attention/metal",
        "//zml/kernels/flash_attention/nki",
        "//zml/kernels/moe/cute",
        "//zml/kernels/moe/flashinfer_cutlass",
        "//zml/kernels/moe/fly",
        "//zml/kernels/moe/metal",
        "//zml/kernels/moe/mosaic_tpu",
        "//zml/kernels/moe/stablehlo",
        "//zml/kernels/moe/tcl",
        "//zml/kernels/moe/triton",
        "//zml/kernels/paged_attention/cute",
        "//zml/kernels/paged_attention/metal",
        "//zml/kernels/paged_attention/mosaic_tpu",
        "//zml/kernels/paged_attention/stablehlo",
        "//zml/kernels/paged_attention/tcl",
        "//zml/kernels/paged_attention/triton",
    ],
    data = select({
        "//platforms:neuron.enabled": [
            "//zml/kernels/flash_attention/nki:attention_kernel",
        ],
        "//conditions:default": [],
    }),
    main = "zml.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    zigopts = [
        "-lc",
        "-freference-trace=20",
    ],
    deps = [
        "//bazel",
        "//dsl/mosaic_tpu:builder",
        "//dsl/tcl:builder",
        "//mlir",
        "//mlir/dialects/llvm",
        "//mlir/dialects/nvvm",
        "//mlir/dialects/ttir",
        "//mlir/dialects/vector",
        "//pjrt",
        "//platforms",
        "//platforms/tpu:ragged_paged",
        "//stdx",
        "//zml/constants",
        "//zml/core",
        "//zml/logo",
        "//zml/meta",
        "//zml/nn",
        "//zml/profiling",
        "//zml/quantization",
        "//zml/tokenizer",
    ] + select({
        "//platforms:neuron.enabled": [
            "//platforms/neuron:nki_kernel",
        ],
        "//conditions:default": [],
    }) + select({
        "//platforms:cuda.enabled": [
            "//platforms/cuda/flashinfer_cutlass_moe",
        ],
        "//conditions:default": [],
    }),
)

zig_test(
    name = "test",
    deps = [":zml"],
)
