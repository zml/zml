load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_library", "zig_test")

package(default_visibility = ["//zml:__pkg__"])

zig_library(
    name = "cute",
    srcs = [
        "attention.zig",
        "//zml/kernels/paged_attention/cute/sm10x",
        "//zml/kernels/paged_attention/cute/sm120",
    ],
    import_name = "zml/kernels/paged_attention/cute",
    main = "cute.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//mlir",
        "//mlir/dialects/llvm",
        "//mlir/dialects/vector",
        "//stdx",
        "//zml/core",
        "//zml/kernels/paged_attention/options",
    ],
)

zig_test(
    name = "test",
    deps = [":cute"],
)

zig_test(
    name = "correctness_test",
    srcs = [
        "cases.zig",
        "fixtures.zig",
        "reference.zig",
    ],
    main = "correctness_test.zig",
    tags = [
        "exclusive",
        "requires-gpu",
    ],
    target_compatible_with = select({
        "//platforms:cuda.enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//zml"],
)

zig_binary(
    name = "benchmark",
    srcs = [
        "cases.zig",
        "fixtures.zig",
    ],
    main = "benchmark.zig",
    tags = ["manual"],
    target_compatible_with = select({
        "//platforms:cuda.enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//zml"],
)
