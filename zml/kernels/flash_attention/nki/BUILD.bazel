load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

filegroup(
    name = "attention_kernel",
    srcs = ["attention.py"],
)

zig_library(
    name = "nki",
    data = select({
        "//platforms:neuron.enabled": [":attention_kernel"],
        "//conditions:default": [],
    }),
    import_name = "zml/kernels/flash_attention/nki",
    main = "nki.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//platforms",
        "//stdx",
        "//zml/core",
    ] + select({
        "//platforms:neuron.enabled": ["//platforms/neuron:nki_kernel"],
        "//conditions:default": [],
    }),
)

py_binary(
    name = "attention_harness",
    srcs = ["attention_harness.py"],
    data = [
        ":attention.py",
        "@libzml_neuron//:sandbox",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@neuron_py_deps//ml_dtypes:pkg",
        "@neuron_py_deps//neuronx_cc:pkg",
        "@neuron_py_deps//nki:pkg",
        "@neuron_py_deps//numpy:pkg",
        "@rules_python//python/runfiles",
    ],
)
