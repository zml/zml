load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_test")

package(default_visibility = ["//zml:__pkg__"])

filegroup(
    name = "cute",
    srcs = [
        "cute.zig",
        "moe.zig",
        "mxfp4.zig",
        "persistent_mxfp4.zig",
    ],
)

zig_binary(
    name = "tune",
    main = "tune.zig",
    visibility = ["//visibility:public"],
    deps = [
        "//zml",
        "//zml/kernels/moe/bench:lib",
    ],
)

zig_test(
    name = "tune_test",
    main = "tune.zig",
    deps = [
        "//zml",
        "//zml/kernels/moe/bench:lib",
    ],
)

# The CuTe MoE on MegaMoE's weight layout against its own layout, bit for bit
# (needs an SM100 GPU, skipped elsewhere). Run with --test_strategy=standalone.
zig_test(
    name = "megamoe_layout_test",
    main = "megamoe_layout_test.zig",
    deps = ["//zml"],
)
