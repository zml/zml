+// The caller has recognized a number-only match. Count codepoints, rather than
+// bytes, so mixed Unicode number categories retain the same grouping as \p{N}.
+static iree_status_t iree_tokenizer_split_emit_number_match(
+    iree_tokenizer_split_callback_context_t* context,
+    iree_tokenizer_regex_match_t match, iree_string_view_t text) {
+  iree_host_size_t position = 0;
+  iree_host_size_t count = 0;
+  while (position < text.size) {
+    iree_unicode_utf8_decode(text, &position);
+    ++count;
+  }
+
+  iree_tokenizer_split_emit(context->emitter, context->last_emit_end,
+                            match.start, context->absolute);
+  position = 0;
+  iree_host_size_t start = match.start;
+  iree_host_size_t group_size = (count - 1) % 3 + 1;
+  while (position < text.size) {
+    for (iree_host_size_t i = 0; i < group_size; ++i) {
+      iree_unicode_utf8_decode(text, &position);
+    }
+    iree_host_size_t end = match.start + position;
+    // finalize() can retry the same match after partially filling the output.
+    if (end > context->last_emit_end) {
+      iree_tokenizer_split_emit(context->emitter, start, end,
+                                context->absolute);
+      if (context->emitter->full) {
+        return iree_status_from_code(IREE_STATUS_RESOURCE_EXHAUSTED);
+      }
+    }
+    start = end;
+    group_size = 3;
+  }
+  context->last_emit_end = match.end;
+  return iree_ok_status();
+}
 
