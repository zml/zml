+TEST(FailedStartAsciiScan, HonorsExactAsciiRangeAtInitialState) {
+  auto data = BuildAbcWithExactRange(0, 1, 'x');
+  iree_tokenizer_regex_dfa_t dfa;
+  IREE_ASSERT_OK(iree_tokenizer_regex_dfa_load(
+      iree_make_const_byte_span(data.data(), data.size()), &dfa));
+  std::string text(2048, 'z');
+  text += "xbc";
+  text.append(33, 'z');
+  text += "abc";
+  CheckFailedStartScanChunks(&dfa, text, {{2048, 2051}, {2084, 2087}});
+}
+
+TEST(FailedStartAsciiScan, StopsBeforeExactNonAsciiRange) {
+  auto data = BuildAbcWithExactRange(0, 1, 0x4E2D);
+  iree_tokenizer_regex_dfa_t dfa;
+  IREE_ASSERT_OK(iree_tokenizer_regex_dfa_load(
+      iree_make_const_byte_span(data.data(), data.size()), &dfa));
+  std::string text(4096, 'z');
+  text += "\xE4\xB8\xAD" "bc";
+  text.append(127, 'z');
+  text += "abc";
+  CheckFailedStartScanChunks(&dfa, text, {{4096, 4101}, {4228, 4231}});
+}
+
