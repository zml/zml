+TEST(FailedStartAsciiScan, PreservesStartAnchorExit) {
+  auto data = BuildStartAnchoredHelloDfa();
+  // Set the actual per-state start constraint that exec_feed checks. The
+  // original fixture has different start states but no anchor bitmap.
+  const size_t offset = data.size();
+  const uint64_t anchors[] = {(1ull << 0) | (1ull << 5), 0};
+  data.resize(offset + sizeof(anchors));
+  auto* header =
+      reinterpret_cast<iree_tokenizer_regex_dfa_header_t*>(data.data());
+  header->flags |= IREE_TOKENIZER_UTIL_REGEX_DFA_FLAG_HAS_ANCHORS;
+  std::memcpy(data.data() + offset, anchors, sizeof(anchors));
+  iree_tokenizer_regex_dfa_t dfa;
+  IREE_ASSERT_OK(iree_tokenizer_regex_dfa_load(
+      iree_make_const_byte_span(data.data(), data.size()), &dfa));
+  CheckFailedStartScanChunks(&dfa, "Hello" + std::string(4096, 'x'), {{0, 5}});
+  CheckFailedStartScanChunks(&dfa, std::string(4096, 'x') + "Hello", {});
+}
