+// Exercises the failed-start scan with hand-built exact range transitions.
+// Ranges may cover ASCII even when the byte table has NO_TRANSITION.
+std::vector<uint8_t> BuildAbcWithExactRange(uint16_t from_state,
+                                          uint16_t target_state,
+                                          uint32_t codepoint) {
+  auto data = BuildAbcDfa();
+  const size_t offset = data.size();
+  data.resize(offset + sizeof(uint32_t) +
+              sizeof(iree_tokenizer_regex_dfa_range_transition_t));
+  auto* header =
+      reinterpret_cast<iree_tokenizer_regex_dfa_header_t*>(data.data());
+  header->flags |= IREE_TOKENIZER_UTIL_REGEX_DFA_FLAG_HAS_RANGES;
+  const uint16_t counts[] = {1, 0};
+  std::memcpy(data.data() + offset, counts, sizeof(counts));
+  const iree_tokenizer_regex_dfa_range_transition_t range = {
+      from_state, target_state, codepoint, codepoint};
+  std::memcpy(data.data() + offset + sizeof(counts), &range, sizeof(range));
+  return data;
+}
+
+void CheckFailedStartScanChunks(
+    const iree_tokenizer_regex_dfa_t* dfa, const std::string& text,
+    const std::vector<std::pair<size_t, size_t>>& expected) {
+  for (bool use_stride : {false, true}) {
+    iree_tokenizer_regex_stride_t* stride = nullptr;
+    if (use_stride) {
+      IREE_ASSERT_OK(iree_tokenizer_regex_stride_allocate(
+          dfa, iree_allocator_system(), &stride));
+    }
+    for (size_t chunk_size : {1, 2, 7, 64, 1024, 4097}) {
+      iree_tokenizer_regex_exec_state_t state;
+      iree_tokenizer_regex_exec_initialize(&state, dfa);
+      MatchCollector actual;
+      size_t offset = 0;
+      while (offset < text.size()) {
+        size_t end = std::min(offset + chunk_size, text.size());
+        // exec_feed requires complete UTF-8 codepoints in each chunk.
+        while (end > offset && end < text.size() &&
+               (static_cast<uint8_t>(text[end]) & 0xC0) == 0x80) {
+          --end;
+        }
+        if (end == offset) {
+          ++end;
+          while (end < text.size() &&
+                 (static_cast<uint8_t>(text[end]) & 0xC0) == 0x80) {
+            ++end;
+          }
+        }
+        IREE_ASSERT_OK(iree_tokenizer_regex_exec_feed(
+            dfa, &state,
+            iree_make_string_view(text.data() + offset, end - offset), offset,
+            stride, MatchCollector::Callback, &actual));
+        offset = end;
+        // Empty feeds must preserve pending/backtrack state and absolute offsets.
+        IREE_ASSERT_OK(iree_tokenizer_regex_exec_feed(
+            dfa, &state, iree_make_string_view("", 0), offset, stride,
+            MatchCollector::Callback, &actual));
+      }
+      IREE_ASSERT_OK(iree_tokenizer_regex_exec_finalize(
+          dfa, &state, text.size(), MatchCollector::Callback, &actual));
+      EXPECT_EQ(actual.matches, expected)
+          << "stride=" << use_stride << " chunk_size=" << chunk_size;
+    }
+    iree_tokenizer_regex_stride_free(stride, iree_allocator_system());
+  }
+}
