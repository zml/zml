    name = "TiledOpTraits",
    srcs = ["lib/Bindings/Python/TiledOpTraits.cpp"],
    hdrs = ["lib/Bindings/Python/TiledOpTraits.h"],
    includes = ["lib/Bindings/Python"],
    deps = [
        ":FlyDialect",
