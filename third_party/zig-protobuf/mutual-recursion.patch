+    fn collectMessageDependencies(
+        self: *GenerationContext,
+        allocator: std.mem.Allocator,
+        parent: []const u8,
+        messages: []const descriptor.DescriptorProto,
+    ) anyerror!void {
+        for (messages) |message| {
+            const name = try std.fmt.allocPrint(allocator, "{s}.{s}", .{ parent, message.name.? });
+            var deps: std.ArrayList([]const u8) = .empty;
+            for (message.field.items) |field| {
+                // Repeated messages already have indirection through ArrayList.
+                if (field.type == .TYPE_MESSAGE and !isRepeated(field)) {
+                    try deps.append(allocator, field.type_name.?[1..]);
+                }
+            }
+            try self.message_deps.put(name, deps);
+            try self.collectMessageDependencies(allocator, name, message.nested_type.items);
+        }
+    }
+
+    fn messageReaches(self: *GenerationContext, allocator: std.mem.Allocator, from: []const u8, target: []const u8) !bool {
+        var pending: std.ArrayList([]const u8) = .empty;
+        defer pending.deinit(allocator);
+        var visited: std.StringHashMap(void) = .init(allocator);
+        defer visited.deinit();
+        try pending.append(allocator, from);
+        while (pending.pop()) |name| {
+            if (std.mem.eql(u8, name, target)) return true;
+            const entry = try visited.getOrPut(name);
+            if (entry.found_existing) continue;
+            if (self.message_deps.get(name)) |deps| {
+                try pending.appendSlice(allocator, deps.items);
+            }
+        }
+        return false;
+    }
