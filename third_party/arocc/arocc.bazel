load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_library")
load("@zml//bazel:zig_options.bzl", "zig_option", "zig_options")

zig_option(
    name = "enable_linker_build_id",
    build_setting_default = False,
)

zig_option(
    name = "linker",
    build_setting_default = "",
)

zig_option(
    name = "sysroot",
    build_setting_default = "",
)

zig_option(
    name = "gcc_install_prefix",
    build_setting_default = "",
)

zig_option(
    name = "rtlib",
    build_setting_default = "",
)

zig_option(
    name = "unwindlib",
    build_setting_default = "",
)

zig_options(
    name = "system_defaults",
    settings = [
        ":enable_linker_build_id",
        ":linker",
        ":sysroot",
        ":gcc_install_prefix",
        ":rtlib",
        ":unwindlib",
    ],
)

zig_option(
    name = "enable_tracy",
    build_setting_default = False,
)

zig_option(
    name = "enable_tracy_callstack",
    build_setting_default = False,
)

zig_option(
    name = "enable_tracy_allocation",
    build_setting_default = False,
)

zig_option(
    name = "debug_allocations",
    build_setting_default = False,
)

zig_option(
    name = "version_str",
    build_setting_default = "<redacted>",
)

zig_options(
    name = "build_options",
    settings = [
        ":enable_tracy",
        ":enable_tracy_callstack",
        ":enable_tracy_allocation",
        ":debug_allocations",
        ":version_str",
    ],
)

zig_library(
    name = "zig",
    srcs = glob(["deps/zig/**/*.zig"]),
    main = "deps/zig/lib.zig",
)

zig_library(
    name = "backend",
    main = "src/backend.zig",
    deps = [
        ":build_options",
        ":zig",
    ],
)

zig_library(
    name = "aro",
    srcs = glob(["src/**/*.zig"]),
    main = "src/aro.zig",
    visibility = ["//visibility:public"],
    deps = [
        ":backend",
        ":build_options",
        ":system_defaults",
    ] + [
        ":{}".format(name.replace("src/aro/", ""))
        for name in glob(["src/aro/**/*.def"])
    ],
)

zig_library(
    name = "assembly_backend",
    main = "src/assembly_backend.zig",
    deps = [
        ":aro",
    ],
)

zig_binary(
    name = "arocc",
    srcs = glob(["src/**/*.zig"]),
    main = "src/main.zig",
    deps = [
        ":aro",
        ":assembly_backend",
        ":build_options",
    ],
    zigopts = ["-fm"],
)

zig_binary(
    name = "generate-def",
    main = "build/generate_def.zig",
)

[
    run_binary(
        name = "def_{}".format(name),
        srcs = [name],
        outs = ["{}.zig".format(name)],
        args = [
            "$(location {})".format(name),
            "$(location {}.zig)".format(name),
        ],
        tool = ":generate-def",
    )
    for name in glob(["src/aro/**/*.def"])
]

[
    zig_library(
        name = "{}".format(name.replace("src/aro/", "")),
        main = ":def_{}".format(name),
    )
    for name in glob(["src/aro/**/*.def"])
]
