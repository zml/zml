+
+test "StackPool: runtime page alignment and full growth" {
+    if (!slab_supported) return error.SkipZigTest;
+
+    for ([_]usize{ 0, 2 }) |slab_slots| {
+        var pool = StackPool.init(.{
+            .maximum_size = 8 * 1024 * 1024,
+            .committed_size = 256 * 1024,
+            .slab_slots = slab_slots,
+        });
+        defer pool.deinit();
+
+        // Keep slots live to exercise each offset and cross a slab boundary.
+        var infos: [3]StackInfo = undefined;
+        var acquired: usize = 0;
+        defer for (infos[0..acquired]) |info| pool.release(info);
+        for (&infos) |*info| {
+            info.* = try pool.acquire();
+            acquired += 1;
+            if (slab_slots != 0) {
+                try std.testing.expect(pool.slabOfLocked(info.allocation_ptr) != null);
+            }
+            try std.testing.expectEqual(0, @intFromPtr(info.allocation_ptr) % stack.pageSize());
+            try std.testing.expectEqual(0, info.limit % stack.pageSize());
+            try stack.stackExtend(info, .grow);
+            try stack.stackExtend(info, .full);
+            try std.testing.expectEqual(@intFromPtr(info.allocation_ptr) + stack.pageSize(), info.limit);
+            const memory: [*]u8 = @ptrFromInt(info.limit);
+            memory[0] = 0xAA;
+            memory[info.base - info.limit - 1] = 0xBB;
+        }
+    }
+}
