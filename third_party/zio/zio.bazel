load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_library")
load("@zml//bazel:zig_options.bzl", "zig_option", "zig_options")

string_flag(
    name = "backend",
    build_setting_default = "",
    values = ["", "poll", "linux", "epoll", "kqueue", "io_uring", "iocp"],
)

string_flag(
    name = "scheduling",
    build_setting_default = "work_stealing",
    values = ["single_executor", "pinned", "work_stealing"],
)

string_flag(
    name = "resolve_beneath_mode",
    build_setting_default = "strict",
    values = ["strict", "best_effort"],
)

zig_option(name = "backend_option", flag = ":backend", nullable = True)
zig_option(name = "scheduling_option", flag = ":scheduling")
zig_option(name = "resolve_beneath_mode_option", flag = ":resolve_beneath_mode")
zig_option(name = "no_hacks", bool = False)
zig_option(name = "scheduler_metrics", bool = False)

zig_options(
    name = "zio_build_options",
    settings = [
        ":backend_option",
        ":scheduling_option",
        ":resolve_beneath_mode_option",
        ":no_hacks",
        ":scheduler_metrics",
    ],
)

zig_library(
    name = "zio",
    main = "src/zio.zig",
    srcs = glob(["src/**/*.zig"]),
    deps = [":zio_build_options"],
    visibility = ["//visibility:public"],
)
