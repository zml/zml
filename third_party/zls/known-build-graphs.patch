+/// Register workspace build roots before any source document needs association.
+pub fn setWorkspace(self: *DocumentStore, uri: Uri, active: bool) error{ Canceled, OutOfMemory }!void {
+    if (!supports_build_system) return;
+    const directory = uri.toFsPath(self.allocator) catch |err| switch (err) {
+        error.UnsupportedScheme => return,
+        error.OutOfMemory => return error.OutOfMemory,
+    };
+    defer self.allocator.free(directory);
+    const path = try std.Io.Dir.path.join(self.allocator, &.{ directory, "build.zig" });
+    defer self.allocator.free(path);
+    const build_uri = try Uri.fromPath(self.allocator, path);
+    defer build_uri.deinit(self.allocator);
+    const build_file = if (active) blk: {
+        if (!try buildDotZigExists(self.io, directory)) return;
+        break :blk try self.getOrLoadBuildFile(build_uri);
+    } else self.getBuildFile(build_uri) orelse return;
+    build_file.is_workspace.store(active, .monotonic);
 }

