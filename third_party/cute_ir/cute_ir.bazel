load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cutegen",
    hdrs = glob(["cutegen/include/cutegen/**/*.hpp"]),
    includes = ["cutegen/include"],
    deps = [
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:MathDialect",
        "@llvm-project//mlir:LLVMDialect",
        "@llvm-project//mlir:SCFDialect",
        "@llvm-project//mlir:UBDialect",
        "@llvm-project//mlir:NVVMDialect",
    ],
)

td_library(
    name = "dialect_td",
    srcs = [
        "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteAttrs.td",
        "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteDialect.td",
        "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteOps.td",
        "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteTypeInterfaces.td",
        "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteTypes.td",
    ],
    includes = ["cute_ir/include"],
    deps = [
        "@llvm-project//mlir:BuiltinDialectTdFiles",
        "@llvm-project//mlir:DataLayoutInterfacesTdFiles",
        "@llvm-project//mlir:InferTypeOpInterfaceTdFiles",
        "@llvm-project//mlir:OpBaseTdFiles",
        "@llvm-project//mlir:SideEffectInterfacesTdFiles",
    ],
)

gentbl_cc_library(
    name = "dialect_inc_gen",
    includes = ["."],
    tbl_outs = [
        (
            ["-gen-dialect-decls", "-dialect=cute"],
            "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteDialect.h.inc",
        ),
        (
            ["-gen-dialect-defs", "-dialect=cute"],
            "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteDialect.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteDialect.td",
    deps = [":dialect_td"],
)

gentbl_cc_library(
    name = "type_interfaces_inc_gen",
    includes = ["."],
    tbl_outs = [
        (
            ["-gen-type-interface-decls"],
            "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteTypeInterfaces.h.inc",
        ),
        (
            ["-gen-type-interface-defs"],
            "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteTypeInterfaces.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteTypeInterfaces.td",
    deps = [":dialect_td"],
)

gentbl_cc_library(
    name = "attrs_inc_gen",
    includes = ["."],
    tbl_outs = [
        (
            ["-gen-attrdef-decls", "-attrdefs-dialect=cute"],
            "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteAttrs.h.inc",
        ),
        (
            ["-gen-attrdef-defs", "-attrdefs-dialect=cute"],
            "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteAttrs.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteAttrs.td",
    deps = [":dialect_td"],
)

gentbl_cc_library(
    name = "ops_inc_gen",
    includes = ["."],
    tbl_outs = [
        (
            ["-gen-op-decls"],
            "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteOps.h.inc",
        ),
        (
            ["-gen-op-defs"],
            "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteOps.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteOps.td",
    deps = [":dialect_td"],
)

