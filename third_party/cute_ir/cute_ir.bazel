load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # BSD-3-Clause

# The CuTe dialect of the cutlass_compiler/ tree, as released. The tree that
# builds it (//mlir/dialects/cute_ir) adds the DSL compiler's own attributes,
# types and operations and compiles these sources with them.
CUTE_IR_INCLUDE = "cute_ir/include"

exports_files([
    "LICENSE.txt",
    CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteDialect.h",
    "cute_ir/lib/Dialect/IR/CuteAttributes.cpp",
    "cute_ir/lib/Dialect/IR/CuteDialect.cpp",
])


# cutegen, the CuTe layout algebra, with the `?{div=N}` leaf added by
# cutegen_dynamic_divisibility.patch: a dynamic extent the DSL knows to be a
# multiple of N, which the release's cutegen cannot read.
cc_library(
    name = "cutegen",
    hdrs = glob(["cutegen/include/cutegen/*.hpp"]),
    includes = ["cutegen/include"],
    deps = [
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:LLVMDialect",
        "@llvm-project//mlir:MathDialect",
        "@llvm-project//mlir:NVVMDialect",
        "@llvm-project//mlir:SCFDialect",
        "@llvm-project//mlir:UBDialect",
    ],
)

td_library(
    name = "cute_ir_dialect_td",
    srcs = [
        CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteAttrs.td",
        CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteDialect.td",
        CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteTypeInterfaces.td",
        CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteTypes.td",
    ],
    includes = [CUTE_IR_INCLUDE],
    deps = [
        "@llvm-project//mlir:BuiltinDialectTdFiles",
        "@llvm-project//mlir:DataLayoutInterfacesTdFiles",
        "@llvm-project//mlir:InferTypeOpInterfaceTdFiles",
        "@llvm-project//mlir:OpBaseTdFiles",
        "@llvm-project//mlir:SideEffectInterfacesTdFiles",
    ],
)

gentbl_cc_library(
    name = "cute_ir_dialect_inc_gen",
    includes = [CUTE_IR_INCLUDE],
    tbl_outs = [
        (
            ["-gen-dialect-decls", "-dialect=cute"],
            CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteDialect.h.inc",
        ),
        (
            ["-gen-dialect-defs", "-dialect=cute"],
            CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteDialect.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteDialect.td",
    deps = [":cute_ir_dialect_td"],
)

gentbl_cc_library(
    name = "cute_ir_type_interfaces_inc_gen",
    includes = [CUTE_IR_INCLUDE],
    tbl_outs = [
        (
            ["-gen-type-interface-decls"],
            CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteTypeInterfaces.h.inc",
        ),
        (
            ["-gen-type-interface-defs"],
            CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteTypeInterfaces.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteTypeInterfaces.td",
    deps = [":cute_ir_dialect_td"],
)

# The header alone: the attribute, type and operation class declarations it
# includes are generated by the building tree, which adds the compiler's own.
cc_library(
    name = "cute_ir_dialect_header",
    hdrs = [CUTE_IR_INCLUDE + "/cute_ir/Dialect/Cute/IR/CuteDialect.h"],
    includes = [CUTE_IR_INCLUDE],
    deps = [
        ":cute_ir_dialect_inc_gen",
        ":cute_ir_type_interfaces_inc_gen",
    ],
)
