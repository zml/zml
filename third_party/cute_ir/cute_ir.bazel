gentbl_cc_library(
    name = "types_decl_inc_gen",
    includes = ["cute_ir/include"],
    tbl_outs = [
        (
            ["-gen-typedef-decls", "-typedefs-dialect=cute"],
            "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteTypes.h.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteTypes.td",
    deps = [":dialect_td"],
)

gentbl_cc_library(
    name = "types_defs_inc_gen",
    includes = ["cute_ir/include"],
    tbl_outs = [
        (
            ["-gen-typedef-defs", "-typedefs-dialect=cute"],
            "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteTypes.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteTypes.td",
    deps = [":dialect_td"],
)

cc_library(
    name = "dialect_headers",
    hdrs = [
        "cute_ir/include/cute_ir/Dialect/Cute/IR/CuteDialect.h",
    ],
    includes = ["cute_ir/include"],
    textual_hdrs = ["cute_ir/lib/Dialect/IR/CuteTypes.cpp"],
    deps = [
        ":attrs_inc_gen",
        ":cutegen",
        ":dialect_inc_gen",
        ":ops_inc_gen",
        ":type_interfaces_inc_gen",
        ":types_decl_inc_gen",
    ],
)

cc_library(
    name = "dialect_support",
    srcs = [
        "cute_ir/lib/Dialect/IR/CuteAttributes.cpp",
        "cute_ir/lib/Dialect/IR/CuteOps.cpp",
    ],
    includes = ["cute_ir/include"],
    deps = [":dialect_headers"],
)

cc_library(
    name = "dialect",
    srcs = [
        "cute_ir/lib/Dialect/Cute/IR/CuteDialect.cpp",
        "cute_ir/lib/Dialect/Cute/IR/CuteTypes.cpp",
    ],
    deps = [
        ":dialect_headers",
        ":dialect_support",
        ":types_defs_inc_gen",
    ],
)
