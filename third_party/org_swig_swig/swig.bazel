load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

licenses(["restricted"])  # GPLv3

exports_files(["LICENSE"])

filegroup(
    name = "lib",
    srcs = glob([
        "Lib/*.*",
        "Lib/c/*.*",
        "Lib/std/*.*",
        "Lib/typemaps/*.*",
    ]),
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "swig",
    srcs = glob([
        "Source/CParse/*.h",
        "Source/CParse/*.c",
        "Source/DOH/*.h",
        "Source/DOH/*.c",
        "Source/Include/*.h",
        "Source/Preprocessor/*.h",
        "Source/Preprocessor/*.c",
        "Source/Swig/*.h",
        "Source/Swig/*.c",
    ]) + [
        "Source/Include/swigconfig.h",
        "Source/Modules/allocate.cxx",
        "Source/Modules/c.cxx",
        "Source/Modules/contract.cxx",
        "Source/Modules/directors.cxx",
        "Source/Modules/emit.cxx",
        "Source/Modules/interface.cxx",
        "Source/Modules/lang.cxx",
        "Source/Modules/main.cxx",
        "Source/Modules/nested.cxx",
        "Source/Modules/overload.cxx",
        "Source/Modules/swigmain-lite.cxx",
        "Source/Modules/swigmod.h",
        "Source/Modules/typepass.cxx",
        "Source/Modules/utils.cxx",
        "Source/Modules/xml.cxx",
    ],
    includes = [
        "Source/CParse",
        "Source/DOH",
        "Source/Include",
        "Source/Modules",
        "Source/Preprocessor",
        "Source/Swig",
    ],
    data = [":lib"],
    output_licenses = ["unencumbered"],
    visibility = ["//visibility:public"],
    deps = ["@pcre2"],
)

genrule(
    name = "swigconfig",
    outs = ["Source/Include/swigconfig.h"],
    cmd = """\
echo '#define HAVE_BOOL
#define HAVE_PCRE
#define HAVE_POPEN
#define PACKAGE_BUGREPORT "http://www.swig.org"
#define PACKAGE_VERSION "4.3.0"
#define STDC_HEADERS
#define SWIG_CXX "bazel4lyfe"
#define SWIG_LIB "external/org_swig_swig/Lib"
#define SWIG_LIB_WIN_UNIX ""
#define SWIG_PLATFORM "bazel4lyfe"' >$@
""",
)

genrule(
    name = "get_rid_of_stuff_we_dont_need_yet",
    srcs = ["Source/Modules/swigmain.cxx"],
    outs = ["Source/Modules/swigmain-lite.cxx"],
    cmd = """\
while IFS= read -r line || [[ -n $$line ]]; do
  case "$$line" in
    *swig_allegrocl*) continue ;;
    *swig_chicken*) continue ;;
    *swig_clisp*) continue ;;
    *swig_csharp*) continue ;;
    *swig_d*) continue ;;
    *swig_go*) continue ;;
    *swig_guile*) continue ;;
    *swig_java*) continue ;;
    *swig_lua*) continue ;;
    *swig_modula3*) continue ;;
    *swig_mzscheme*) continue ;;
    *swig_ocaml*) continue ;;
    *swig_octave*) continue ;;
    *swig_perl*) continue ;;
    *swig_php*) continue ;;
    *swig_pike*) continue ;;
    *swig_python*) continue ;;
    *swig_r*) continue ;;
    *swig_ruby*) continue ;;
    *swig_scilab*) continue ;;
    *swig_sexp*) continue ;;
    *swig_tcl*) continue ;;
    *swig_uffi*) continue ;;
  esac
  printf '%s\\n' "$$line"
done <$< >$@
""",
)
