diff --git a/zig/settings/BUILD.bazel b/zig/settings/BUILD.bazel
index 417a898..1628776 100644
--- a/zig/settings/BUILD.bazel
+++ b/zig/settings/BUILD.bazel
@@ -99,3 +99,13 @@ filegroup(
     srcs = [":BUILD.bazel"],
     visibility = ["//zig:__pkg__"],
 )
+
+# An executable adapter implementing Bazel's JSON persistent worker protocol.
+# An empty filegroup keeps ordinary builds on the direct compiler path.
+label_flag(
+    name = "incremental_worker",
+    build_setting_default = ":no_incremental_worker",
+    visibility = ["//visibility:public"],
+)
+
+filegroup(name = "no_incremental_worker")
