+def _zig_args(ctx):
+    args = ctx.actions.args()
+    incremental = ctx.attr._incremental_worker[DefaultInfo].files_to_run.executable != None and ctx.genfiles_dir.path.find("-exec") == -1
+    args.use_param_file("@%s", use_always = incremental)
+    if incremental:
+        args.set_param_file_format("multiline")
+    return args
+
+def _run_zig(ctx, *, executable, arguments, outputs, mnemonic, **kwargs):
+    worker = ctx.attr._incremental_worker[DefaultInfo].files_to_run
+
+    # Host tools must remain independent of the incremental adapter.
+    if worker.executable == None or ctx.genfiles_dir.path.find("-exec") != -1:
+        ctx.actions.run(executable = executable, arguments = arguments, outputs = outputs, mnemonic = mnemonic, **kwargs)
+        return
+
+    if not semver.gte(zig_exec_group_toolchain(ctx).zig_version, "0.17.0"):
+        fail("incremental_worker requires Zig 0.17 or newer")
+
+    command = _zig_args(ctx)
+    request_args = [command]
+    for arg in arguments:
+        if type(arg) == "string":
+            command.add(arg)
+        else:
+            request_args.append(arg)
+
+    requirements = dict(kwargs.pop("execution_requirements", {}))
+    requirements.update({
+        "supports-workers": "1",
+        "requires-worker-protocol": "json",
+        "no-remote": "1",
+        "no-sandbox": "1",
+    })
+    ctx.actions.run(
+        executable = worker,
+        # Each output owns a compiler session; source edits do not change its key.
+        arguments = [
+            "--zig=" + (executable.path if type(executable) == "File" else executable),
+            "--action=" + outputs[0].path,
+        ] + request_args,
+        tools = [executable] if type(executable) == "File" else [],
+        outputs = outputs,
+        mnemonic = "ZigIncremental",
+        execution_requirements = requirements,
+        **kwargs
+    )
+
 def _executable_extension(os):
     return ".exe" if os == "windows" else ""
 
