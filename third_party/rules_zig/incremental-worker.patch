+    # Preserve version suffixes and Bazel's library names verbatim.
+    return file.path
 
@@ -147 +149,13 @@ def _make_to_rpath(solib_parents, os):
     return to_rpath
+
+def zig_cdeps_link_flag(flag):
+    """Translate compiler-driver linker flags used by C dependencies."""
+    if flag.startswith("-Wl,-u,"):
+        return ["--force_undefined", flag[len("-Wl,-u,"):]]
+    if flag.startswith("-Wl,-z,"):
+        return ["-z", flag[len("-Wl,-z,"):]]
+    if flag.startswith("-Wl,-rpath,"):
+        return ["-rpath", flag[len("-Wl,-rpath,"):]]
+    if flag == "-pthread":
+        return "-lpthread"
+    return flag
