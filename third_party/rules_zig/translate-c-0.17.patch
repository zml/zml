diff --git a/zig/private/common/cdeps.bzl b/zig/private/common/cdeps.bzl
--- a/zig/private/common/cdeps.bzl
+++ b/zig/private/common/cdeps.bzl
@@ -85,6 +85,35 @@
         uniquify = True,
     )
 
+def zig_cdeps_linker_input_files(*, linking_context):
+    """Collect files needed to replay a C/C++ link outside of Bazel."""
+    inputs = []
+    for link in linking_context.linker_inputs.to_list():
+        inputs.extend(link.additional_inputs)
+        for lib in link.libraries:
+            _append_linker_files(inputs, lib.static_library)
+            _append_linker_files(inputs, lib.pic_static_library)
+            _append_linker_files(inputs, lib.interface_library)
+            _append_linker_files(inputs, lib.dynamic_library)
+            _append_linker_files(inputs, getattr(lib, "resolved_symlink_dynamic_library", None))
+            _append_linker_files(inputs, getattr(lib, "resolved_symlink_interface_library", None))
+            _append_linker_files(inputs, getattr(lib, "objects", None))
+            _append_linker_files(inputs, getattr(lib, "pic_objects", None))
+            _append_linker_files(inputs, getattr(lib, "lto_bitcode_files", None))
+            _append_linker_files(inputs, getattr(lib, "pic_lto_bitcode_files", None))
+
+    return inputs
+
+def _append_linker_files(inputs, files):
+    if not files:
+        return
+    if hasattr(files, "to_list"):
+        inputs.extend(files.to_list())
+    elif type(files) == "list" or type(files) == "tuple":
+        inputs.extend(files)
+    else:
+        inputs.append(files)
+
 def _lib_flags(arg):
     (file, dynamic) = arg
     if dynamic:
