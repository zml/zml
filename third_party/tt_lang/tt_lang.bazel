# Mirrors lib/Target/TTKernel/CMakeLists.txt's LLK_HEADERS: each LLK header is
# embedded as a raw string into TTKernelToCpp's generated C++.
_LLK_HEADERS = [
    "experimental_constant_table",
    "experimental_coord_translation",
    "experimental_fabric_1d_routing",
    "experimental_fabric_2d_routing",
    "experimental_fabric_api",
    "experimental_fabric_topology_info",
    "experimental_invoke_sfpi_llks",
    "experimental_matmul_llks",
    "experimental_pack_untilize_llks",
    "experimental_padding_llks",
    "experimental_reg_api",
    "experimental_routing_plane",
    "experimental_routing_plane_scatter_write",
    "experimental_routing_plane_write",
    "experimental_row_normalization",
    "experimental_semaphore",
    "experimental_tilize_llks",
    "experimental_untilize_llks",
]

# Same output as cmake/modules/GenerateRawStringHeader.cmake (the header
# comment carries the repository-relative path instead of an absolute one).
_RAW_STRING_HEADER_CMD = """{
  printf '// Auto-generated from %s - Do not edit directly\\n' '@SRC@'
  printf 'static constexpr char %s[] = R"TTLANG_STR_DELIM(\\n' '@VAR@'
  cat $<
  printf ')TTLANG_STR_DELIM";\\n'
  printf 'static constexpr unsigned int %s_len = sizeof(%s) - 1;\\n' '@VAR@' '@VAR@'
} > $@
"""

[
    genrule(
        name = "llk_{}_generated".format(name),
        srcs = ["include/ttlang/Target/TTKernel/LLKs/{}.h".format(name)],
        outs = ["include/ttlang/Target/TTKernel/LLKs/{}_generated.h".format(name)],
        cmd = _RAW_STRING_HEADER_CMD.replace(
            "@SRC@",
            "include/ttlang/Target/TTKernel/LLKs/{}.h".format(name),
        ).replace("@VAR@", "{}_generated".format(name)),
    )
    for name in _LLK_HEADERS
]

genrule(
    name = "dfb_descriptor_prelude_generated",
    srcs = ["include/ttlang/Target/TTKernel/DFBDescriptorPrelude.inc"],
    outs = ["include/ttlang/Target/TTKernel/DFBDescriptorPrelude_generated.h"],
    cmd = _RAW_STRING_HEADER_CMD.replace(
        "@SRC@",
        "include/ttlang/Target/TTKernel/DFBDescriptorPrelude.inc",
    ).replace("@VAR@", "dfb_descriptor_prelude_generated"),
)

# include/ttlang/Config.h.in, configured like CMake does without a device and
# without a git tag to derive the version from.
genrule(
    name = "config_h",
    srcs = ["include/ttlang/Config.h.in"],
    outs = ["include/ttlang/Config.h"],
    cmd = "sed -e 's/@TTLANG_HAS_DEVICE_INT@/0/' -e 's/@TTLANG_VERSION@/0.0.0+unknown/' $< > $@",
)

