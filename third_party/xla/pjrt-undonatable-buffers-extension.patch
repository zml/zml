+#ifndef XLA_PJRT_C_PJRT_C_API_UNDONATABLE_BUFFERS_EXTENSION_H_
+#define XLA_PJRT_C_PJRT_C_API_UNDONATABLE_BUFFERS_EXTENSION_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "xla/pjrt/c/pjrt_c_api.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Undonatable buffers are inputs that executions never donate, such as
+// weights. Executions read them without taking a hold or recording a usage
+// event, which removes most of the per-argument cost of an execution.
+//
+// Executions do not extend their lifetime: destroy an undonatable buffer only
+// once the executions reading it no longer need it, as stream-ordered
+// deallocation does on the compute stream. Passing one as a donated input
+// fails.
+
+#define PJRT_API_UNDONATABLE_BUFFERS_EXTENSION_VERSION 1
+
+struct PJRT_Buffer_MakeUndonatable_Args {
+  size_t struct_size;
+  PJRT_Extension_Base* extension_start;
+  PJRT_Buffer* buffer;
+};
+PJRT_DEFINE_STRUCT_TRAITS(PJRT_Buffer_MakeUndonatable_Args, buffer);
+
+// Converts `buffer` in place: the handle stays valid and aliases the same
+// device memory. The buffer must not be used concurrently, as for
+// PJRT_Buffer_Destroy. Converting an undonatable buffer does nothing. Fails,
+// leaving the buffer unchanged, if it is deleted or donated, has external
+// references, or its client does not support undonatable buffers.
+typedef PJRT_Error* PJRT_Buffer_MakeUndonatable(
+    PJRT_Buffer_MakeUndonatable_Args* args);
+
+struct PJRT_Buffer_IsUndonatable_Args {
+  size_t struct_size;
+  PJRT_Extension_Base* extension_start;
+  PJRT_Buffer* buffer;
+  bool is_undonatable;  // out
+};
+PJRT_DEFINE_STRUCT_TRAITS(PJRT_Buffer_IsUndonatable_Args, is_undonatable);
+
+typedef PJRT_Error* PJRT_Buffer_IsUndonatable(
+    PJRT_Buffer_IsUndonatable_Args* args);
+
+typedef struct PJRT_UndonatableBuffers_Extension {
+  PJRT_Extension_Base base;
+  PJRT_Buffer_MakeUndonatable* make_undonatable;
+  PJRT_Buffer_IsUndonatable* is_undonatable;
+} PJRT_UndonatableBuffers_Extension;
+PJRT_DEFINE_STRUCT_TRAITS(PJRT_UndonatableBuffers_Extension, is_undonatable);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // XLA_PJRT_C_PJRT_C_API_UNDONATABLE_BUFFERS_EXTENSION_H_
