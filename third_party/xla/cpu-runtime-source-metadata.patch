 #include "llvm/ADT/StringRef.h"
@@ -204,8 +205,34 @@
     absl::StrAppend(&op_name, " (", it->second, ")");
   }
 
-  return Thunk::Info{std::move(op_name), std::move(module_name),
-                     module->unique_id()};
+  Thunk::Info info{std::move(op_name), std::move(module_name),
+                   module->unique_id()};
+  const OpMetadata& metadata = instruction->metadata();
+  info.framework_op = metadata.op_name();
+  if (!metadata.source_file().empty()) {
+    info.source =
+        absl::StrCat(metadata.source_file(), ":", metadata.source_line());
+  }
+  StackFrameId frame_id{metadata.stack_frame_id()};
+  while (frame_id.valid()) {
+    const HloStackFrame frame = module->get_stack_frame(frame_id);
+    if (frame.empty()) break;
+    if (info.source.empty() && !frame.file_name.empty()) {
+      info.source = absl::StrCat(frame.file_name, ":", frame.line);
+      if (frame.column != 0) absl::StrAppend(&info.source, ":", frame.column);
+    }
+    if (!info.source_stack.empty()) absl::StrAppend(&info.source_stack, " <- ");
+    absl::StrAppendFormat(&info.source_stack, "%v", frame);
+    frame_id = frame.parent_frame_id;
+  }
+  // TraceMe uses '#' and ',' as delimiters. Escape source strings once here,
+  // rather than formatting stack frames on every execution.
+  for (std::string* value :
+       {&info.source, &info.source_stack, &info.framework_op}) {
+    *value =
+        absl::StrReplaceAll(*value, {{"%", "%25"}, {"#", "%23"}, {",", "%2C"}});
+  }
+  return info;
 }
 
