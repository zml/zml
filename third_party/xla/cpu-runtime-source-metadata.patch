diff --git a/xla/backends/cpu/runtime/thunk_test.cc b/xla/backends/cpu/runtime/thunk_test.cc
--- a/xla/backends/cpu/runtime/thunk_test.cc
+++ b/xla/backends/cpu/runtime/thunk_test.cc
@@ -24,7 +24,41 @@
 #include "xla/tsl/platform/test.h"
 
 namespace xla::cpu {
+class ThunkTestPeer {
+ public:
+  static std::string Encode(const Thunk& thunk) {
+    return thunk.TraceMeEncode(25, 0);
+  }
+};
 namespace {
+
+TEST(ThunkTest, TraceMeIncludesModelSource) {
+  class TracedThunk : public Thunk {
+   public:
+    explicit TracedThunk(Info info) : Thunk(Kind::kKernel, std::move(info)) {}
+    BufferUses buffer_uses() const override { return {}; }
+    tsl::AsyncValueRef<ExecuteEvent> Execute(const ExecuteParams&) override {
+      return OkExecuteEvent();
+    }
+  };
+  Thunk::Info info{"wrapped_convolution.2", "mimi", 12};
+  info.source = "mimi/convolution.zig:99";
+  info.source_stack =
+      "mimi/convolution.zig:99 [ConvTranspose1d] <- "
+      "mimi/seanet.zig:71 [stage[1]]";
+  info.framework_op = "ConvTranspose1d.convolve";
+  const TracedThunk thunk(std::move(info));
+  const std::string trace = ThunkTestPeer::Encode(thunk);
+  EXPECT_NE(trace.find("hlo_op=wrapped_convolution.2"), std::string::npos);
+  EXPECT_NE(trace.find("source=mimi/convolution.zig:99"), std::string::npos);
+  EXPECT_NE(
+      trace.find("source_stack=mimi/convolution.zig:99 [ConvTranspose1d] <- "
+                 "mimi/seanet.zig:71 [stage[1]]"),
+      std::string::npos);
+  EXPECT_NE(trace.find("framework_op=ConvTranspose1d.convolve"),
+            std::string::npos);
+  EXPECT_NE(trace.find("run_id=25"), std::string::npos);
+}
 
