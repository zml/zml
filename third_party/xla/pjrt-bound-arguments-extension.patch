+#ifndef XLA_PJRT_C_PJRT_C_API_BOUND_ARGUMENTS_EXTENSION_H_
+#define XLA_PJRT_C_PJRT_C_API_BOUND_ARGUMENTS_EXTENSION_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "xla/pjrt/c/pjrt_c_api.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Bound arguments are buffers bound to parameters of a loaded executable once,
+// for many executions, such as weights. Executions skip the per-argument work
+// of bound parameters: holds, usage events, checks and address lookups.
+//
+// Bound parameters must not be donated by the executable, and bound buffers
+// cannot be donated while bound. Bound buffers must outlive the binding, which
+// keeps their memory alive even if they are deleted. Executions keep the
+// memory of bound buffers alive until they complete, so the binding and the
+// buffers can be destroyed while they run.
+
+#define PJRT_API_BOUND_ARGUMENTS_EXTENSION_VERSION 1
+
+typedef struct PJRT_BoundArguments PJRT_BoundArguments;
+
+struct PJRT_BoundArguments_Create_Args {
+  size_t struct_size;
+  PJRT_Extension_Base* extension_start;
+  PJRT_LoadedExecutable* executable;
+  // Sorted and unique parameter indices to bind.
+  const int64_t* parameter_indices;
+  size_t num_parameters;
+  // `argument_lists[i][j]` is the buffer of parameter `parameter_indices[j]`
+  // on the i-th device returned by PJRT_Executable_AddressableDevices.
+  PJRT_Buffer* const* const* argument_lists;
+  size_t num_devices;
+  PJRT_BoundArguments* bound_arguments;  // out
+};
+PJRT_DEFINE_STRUCT_TRAITS(PJRT_BoundArguments_Create_Args, bound_arguments);
+
+// Waits until the buffers are defined and binds them. Fails if a buffer is not
+// on its device, does not match its parameter, or may be donated.
+typedef PJRT_Error* PJRT_BoundArguments_Create(
+    PJRT_BoundArguments_Create_Args* args);
+
+struct PJRT_BoundArguments_Destroy_Args {
+  size_t struct_size;
+  PJRT_Extension_Base* extension_start;
+  PJRT_BoundArguments* bound_arguments;
+};
+PJRT_DEFINE_STRUCT_TRAITS(PJRT_BoundArguments_Destroy_Args, bound_arguments);
+
+// Releases the bound buffers, which can then be donated or destroyed.
+typedef PJRT_Error* PJRT_BoundArguments_Destroy(
+    PJRT_BoundArguments_Destroy_Args* args);
+
+// Chain into `PJRT_ExecuteOptions.extension_start`, with type
+// PJRT_Extension_Type_BoundArguments, to execute with bound arguments.
+// Argument lists hold NULL, or the bound buffer, at bound parameters.
+typedef struct PJRT_ExecuteOptions_BoundArguments {
+  PJRT_Extension_Base base;
+  PJRT_BoundArguments* bound_arguments;
+} PJRT_ExecuteOptions_BoundArguments;
+PJRT_DEFINE_STRUCT_TRAITS(PJRT_ExecuteOptions_BoundArguments, bound_arguments);
+
+typedef struct PJRT_BoundArguments_Extension {
+  PJRT_Extension_Base base;
+  PJRT_BoundArguments_Create* create;
+  PJRT_BoundArguments_Destroy* destroy;
+} PJRT_BoundArguments_Extension;
+PJRT_DEFINE_STRUCT_TRAITS(PJRT_BoundArguments_Extension, destroy);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // XLA_PJRT_C_PJRT_C_API_BOUND_ARGUMENTS_EXTENSION_H_
