load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_test")
load("@rules_zig//zig:toolchain.bzl", "zig_target_toolchain")
load(":bootstrap.bzl", "worker_binary", "worker_test")

worker_binary(
    name = "worker",
    main = "worker.zig",
    visibility = ["//visibility:public"],
)

worker_test(
    name = "worker_test",
    size = "small",
    srcs = ["worker.zig"],
    main = "worker_test.zig",
    worker = ":worker",
)

cc_library(
    name = "extern_type_header",
    hdrs = ["extern_type.h"],
)

zig_test(
    name = "extern_type_test",
    size = "small",
    main = "extern_type_test.zig",
    deps = [":extern_type_header"],
)

# Match the C/C++ toolchain's minimum glibc when Zig performs the final link.
zig_target_toolchain(
    name = "linux_target",
    target = "x86_64-linux-gnu.2.28",
)

toolchain(
    name = "linux_target_toolchain",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":linux_target",
    toolchain_type = "@rules_zig//zig/target:toolchain_type",
)
