load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library")

cc_library(
    name = "retain_runfiles_init",
    srcs = ["runfiles_init.c"],
    # This object registers the runfiles initializer before Zig main.
    alwayslink = True,
)

zig_library(
    name = "bazel",
    main = "bazel.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":retain_runfiles_init",
        "//stdx",
        "@rules_zig//zig/runfiles",
    ],
)
