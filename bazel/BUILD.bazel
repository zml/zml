load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

cc_library(
    name = "retain_runfiles_init",
    srcs = ["runfiles_init.c"],
    alwayslink = True,
)

zig_library(
    name = "bazel",
    main = "bazel.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":retain_runfiles_init",
        "//stdx",
        "@rules_zig//zig/runfiles",
    ],
)

zig_test(
    name = "test",
    data = ["runfiles_init.c"],
    main = "bazel_test.zig",
    deps = [":bazel"],
)
