load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_library")

cc_library(
    name = "retain_runfiles_init",
    # Mach-O adds an underscore to the exported Zig symbol.
    linkopts = select({
        "@platforms//os:macos": ["-Wl,-u,__bazel_runfiles_init"],
        "//conditions:default": ["-Wl,-u,_bazel_runfiles_init"],
    }),
)

zig_library(
    name = "bazel",
    main = "bazel.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":retain_runfiles_init",
        "//stdx",
        "@rules_zig//zig/runfiles",
    ],
)

# Exercise constructor retention and real runfiles lookup through the C linker.
zig_binary(
    name = "runfiles_check",
    testonly = True,
    data = ["runfiles_fixture.txt"],
    emit_llvm_bc = True,
    env = {"ZML_RUNFILES_TEST_DATA": "$(rlocationpath :runfiles_fixture.txt)"},
    main = "bazel.zig",
    deps = [
        ":retain_runfiles_init",
        "//stdx",
        "@rules_zig//zig/runfiles",
    ],
)

# Zig cannot use -flto for Mach-O. Feed its bitcode to the C linker instead.
filegroup(
    name = "runfiles_check_bitcode",
    testonly = True,
    srcs = [":runfiles_check"],
    output_group = "llvm_bc",
)

cc_test(
    name = "runfiles_check_lto",
    size = "small",
    additional_linker_inputs = [":runfiles_check_bitcode"],
    data = ["runfiles_fixture.txt"],
    env = {"ZML_RUNFILES_TEST_DATA": "$(rlocationpath :runfiles_fixture.txt)"},
    linkopts = [
        "-flto",
        "$(location :runfiles_check_bitcode)",
    ],
    deps = [":retain_runfiles_init"],
)
