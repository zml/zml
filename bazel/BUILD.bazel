load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library")

bool_flag(
    name = "zig_direct",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "zig_direct_enabled",
    constraint_values = ["@platforms//os:linux"],
    flag_values = {":zig_direct": "true"},
    visibility = ["//visibility:public"],
)

cc_library(
    name = "retain_runfiles_init",
    srcs = ["runfiles_init.c"],
    # This object registers the runfiles initializer before Zig main.
    alwayslink = True,
)

zig_library(
    name = "bazel",
    main = "bazel.zig",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":retain_runfiles_init",
        "//stdx",
        "@rules_zig//zig/runfiles",
    ],
)
