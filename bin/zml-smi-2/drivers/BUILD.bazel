load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

package(default_visibility = ["//bin/zml-smi-2:__subpackages__"])

zig_library(
    name = "native",
    srcs = [
        "shared/counter.zig",
        "shared/dynlib.zig",
        "shared/fdinfo.zig",
        "shared/hwmon.zig",
        "shared/pci.zig",
        "shared/proc.zig",
        "shared/sandbox.zig",
        "shared/sysfs.zig",
        "shared/units.zig",
    ],
    import_name = "zml-smi-2/native",
    main = "shared/native.zig",
    deps = [
        "//stdx",
        "@rules_zig//zig/runfiles",
    ],
)

cc_library(
    name = "macos_host_headers",
    hdrs = ["host/macos.h"],
    target_compatible_with = ["@platforms//os:macos"],
)

zig_library(
    name = "host",
    srcs = [
        "host/linux.zig",
        "host/macos.zig",
    ],
    import_name = "zml-smi-2/host",
    main = "host.zig",
    deps = [
        ":native",
        "//bin/zml-smi-2/contract",
    ] + select({
        "@platforms//os:macos": [":macos_host_headers"],
        "//conditions:default": [],
    }),
)

zig_test(
    name = "test",
    srcs = [
        "host/test_macos.zig",
        "shared/test_counter.zig",
        "shared/test_dynlib.zig",
        "shared/test_fdinfo.zig",
        "shared/test_hwmon.zig",
        "shared/test_pci.zig",
        "shared/test_proc.zig",
        "shared/test_sandbox.zig",
        "shared/test_sysfs.zig",
        "shared/test_units.zig",
    ],
    data = ["//bin/zml-smi-2:sandbox"],
    main = "test_native.zig",
    deps = [
        ":host",
        ":native",
        "//bin/zml-smi-2/contract",
    ],
)
