load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

_DEPS = [
    ":tpuinfo",
    "//bin/zml-smi-2/collect:source",
    "//bin/zml-smi-2/contract",
    "//bin/zml-smi-2/drivers:native",
]

cc_library(
    name = "tpuinfo",
    srcs = ["tpuinfo.cc"],
    hdrs = ["tpuinfo.h"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@cloud_accelerator_diagnostics//:tpu_metric_service_cc_grpc",
        "@grpc//:grpc++_unsecure",
    ],
)

zig_library(
    name = "tpu",
    import_name = "zml-smi-2/drivers/tpu",
    main = "Tpu.zig",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//bin/zml-smi-2:__subpackages__"],
    deps = _DEPS,
)

zig_test(
    name = "test",
    srcs = ["Tpu.zig"],
    main = "test_tpu.zig",
    target_compatible_with = ["@platforms//os:linux"],
    deps = _DEPS,
)
