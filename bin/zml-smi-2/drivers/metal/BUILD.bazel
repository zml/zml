load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

zig_library(
    name = "metal",
    srcs = [
        "Smc.zig",
        "iokit.zig",
    ],
    import_name = "zml-smi-2/drivers/metal",
    main = "Metal.zig",
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//bin/zml-smi-2:__subpackages__"],
    deps = [
        "//bin/zml-smi-2/collect:source",
        "//bin/zml-smi-2/contract",
        "//bin/zml-smi-2/drivers:native",
    ],
)

zig_test(
    name = "test",
    main = "test_metal.zig",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":metal",
        "//bin/zml-smi-2/collect:source",
        "//bin/zml-smi-2/contract",
    ],
