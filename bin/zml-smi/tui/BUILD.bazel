load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

_SRCS = [
    "data.zig",
    "image_cache.zig",
    "lib/compose.zig",
    "lib/image.zig",
    "lib/ui.zig",
    "lib/utils.zig",
    "pages/detail.zig",
    "pages/detail/detail_common.zig",
    "pages/overview.zig",
    "presentation.zig",
    "print.zig",
    "theme.zig",
    "top.zig",
    "widgets/braille_chart.zig",
    "widgets/chart.zig",
    "widgets/column_layout.zig",
    "widgets/device_card.zig",
    "widgets/gauge.zig",
    "widgets/info_lines.zig",
    "widgets/logo.zig",
    "widgets/metric_card.zig",
    "widgets/process_table.zig",
    "widgets/status_line.zig",
    "widgets/titled_border.zig",
]

_ASSETS = [
    "assets/amd.png",
    "assets/intel.png",
    "assets/logo.png",
    "assets/neuron.png",
    "assets/nvidia.png",
    "assets/tpu.png",
]

_DEPS = [
    "//bazel/stamp:zig",
    "//bin/zml-smi/smi:model",
    "//zml:logo",
    "@libvaxis//:vaxis",
]

zig_library(
    name = "tui",
    srcs = _SRCS,
    extra_srcs = _ASSETS,
    import_name = "zml-smi/tui",
    main = "tui.zig",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

zig_test(
    name = "test",
    srcs = _SRCS + [
        "lib/test_image.zig",
        "lib/test_utils.zig",
        "pages/detail/test_detail_common.zig",
        "test_data.zig",
        "tui.zig",
        "widgets/test_gauge.zig",
    ],
    extra_srcs = _ASSETS,
    main = "test_tui.zig",
    deps = _DEPS,
)
