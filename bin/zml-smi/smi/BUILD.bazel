load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

_SRCS = [
    "api.zig",
    "collector.zig",
    "counter.zig",
    "csv.zig",
    "double_buffer.zig",
    "dynlib.zig",
    "fdinfo.zig",
    "host/linux.zig",
    "host/macos.zig",
    "hwmon.zig",
    "json.zig",
    "model.zig",
    "pci.zig",
    "proc.zig",
    "prometheus.zig",
    "remote.zig",
    "sandbox.zig",
    "sysfs.zig",
    "telemetry.zig",
    "units.zig",
]

_DEPS = ["@rules_zig//zig/runfiles"]

zig_library(
    name = "smi",
    srcs = _SRCS,
    import_name = "zml-smi",
    main = "smi.zig",
    visibility = ["//bin/zml-smi:__subpackages__"],
    deps = _DEPS,
)

zig_test(
    name = "test",
    srcs = _SRCS + [
        "host/test_macos.zig",
        "smi.zig",
        "test_collector.zig",
        "test_counter.zig",
        "test_double_buffer.zig",
        "test_dynlib.zig",
        "test_fdinfo.zig",
        "test_hwmon.zig",
        "test_json.zig",
        "test_model.zig",
        "test_pci.zig",
        "test_proc.zig",
        "test_prometheus.zig",
        "test_remote.zig",
        "test_sandbox.zig",
        "test_sysfs.zig",
        "test_units.zig",
    ],
    # The sandbox test looks the directory up through the runfiles.
    data = ["//bin/zml-smi:sandbox"],
    main = "test_smi.zig",
    deps = _DEPS,
)
