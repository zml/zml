load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

cc_library(
    name = "tpuinfo",
    srcs = ["tpuinfo.cc"],
    hdrs = ["tpuinfo.h"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@cloud_accelerator_diagnostics//:tpu_metric_service_cc_grpc",
        "@grpc//:grpc++_unsecure",
    ],
)

zig_library(
    name = "tpu",
    import_name = "zml-smi/platforms/tpu",
    main = "Tpu.zig",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//bin/zml-smi:__subpackages__"],
    deps = [
        ":tpuinfo",
        "//bin/zml-smi/smi",
    ],
)

zig_test(
    name = "test",
    deps = [":tpu"],
)
