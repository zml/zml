load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

zig_library(
    name = "furiosa",
    import_name = "zml-smi/platforms/furiosa",
    main = "Furiosa.zig",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//bin/zml-smi:__subpackages__"],
    deps = [
        "//bin/zml-smi/smi:model",
        "//bin/zml-smi/smi:native",
        "//bin/zml-smi/smi:source",
        "//bin/zml-smi/smi:telemetry",
    ],
)

zig_test(
    name = "test",
    main = "test_furiosa.zig",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":furiosa",
        "//bin/zml-smi/smi:model",
        "//bin/zml-smi/smi:native",
        "//bin/zml-smi/smi:source",
    ],
)
