load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# Hack til rules_zig support `-iframework <sysroot>/System/Library/Frameworks` or similar.
cc_library(
    name = "frameworks",
    linkopts = [
        "-Wl,-framework,CoreFoundation",
        "-Wl,-framework,IOKit",
        "-lIOReport",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

zig_library(
    name = "metal",
    srcs = [
        "Smc.zig",
        "c.zig",
    ],
    import_name = "zml-smi/platforms/metal",
    main = "Metal.zig",
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//bin/zml-smi:__subpackages__"],
    deps = [
        ":frameworks",
        "//bin/zml-smi/smi",
    ],
)

zig_test(
    name = "test",
    deps = [":metal"],
)
