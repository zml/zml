load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

zig_library(
    name = "amdsmi",
    import_name = "zml-smi/platforms/amdsmi",
    main = "AmdSmi.zig",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//bin/zml-smi:__subpackages__"],
    deps = [
        "//bin/zml-smi/smi:model",
        "//bin/zml-smi/smi:native",
        "//bin/zml-smi/smi:source",
        "//bin/zml-smi/smi:telemetry",
        "@amdrocm-amdsmi//:amdsmi",
    ],
)

zig_test(
    name = "test",
    main = "test_amdsmi.zig",
    deps = [":amdsmi"],
)
